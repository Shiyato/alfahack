    {
      "id": 15,
      "title": "Перекос нагрузки по апстримам (CV)",
      "description": "Вторая метрика Парето-фронта: коэффициент вариации по in-flight токенам. Ноль — идеально равномерно. Численно доказывает отсутствие перекоса (§2.1).",
      "type": "timeseries",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 41
      },
      "targets": [
        {
          "expr": "stddev(gateway_inflight_tokens) / clamp_min(avg(gateway_inflight_tokens), 1)",
          "legendFormat": "CV",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
