# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/

# Go
/mock-upstream/mockup
/mock-upstream/mock-upstream
/loadtest/bench/bench
*.test

# Результаты замеров: сырые прогоны не версионируем, в репозиторий
# попадают только сведённые таблицы в docs/benchmarks.md
/loadtest/results/
*.local.json

# Индекс CodeGraph: локален для машины, стареет при первой правке кода
# и конфликтует при слиянии. В git живёт текстовая выгрузка —
# docs/codegraph.md, см. tools/README.md. Сам каталог с его .gitignore
# версионируется, чтобы репозиторий был помечен как индексируемый.
.codegraph/*
!.codegraph/.gitignore

# Окружение
.env
.DS_Store
